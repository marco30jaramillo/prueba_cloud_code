# Configuración del servidor
PORT=3000

# JWT Secret - Cambia esto en producción con un valor seguro
# Usa: openssl rand -base64 32
JWT_SECRET=your-super-secret-key-change-this-in-production

# URL de la aplicación (para enlaces de recuperación de contraseña)
APP_URL=http://localhost:3000

# Opcional: Configuración de email (futuro)
# EMAIL_SERVICE=gmail
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-app-password
# EMAIL_FROM=noreply@example.com

# Opcional: Base de datos
# DATABASE_URL=postgresql://user:password@localhost:5432/auth_db
# DATABASE_POOL_SIZE=10

# Modo de ejecución
NODE_ENV=development
