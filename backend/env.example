# ============================================================
# Mi Valecito - backend - ejemplo de configuración LOCAL
#
# Copia este archivo como backend/.env y completa los dos valores vacíos
# (JWT_SECRET y DB_PASSWORD). Tal cual está, el backend NO arranca: la
# validación de arranque rechaza un secreto ausente y una contraseña vacía.
#
# backend/.env no se versiona. Nunca escribas valores reales en este archivo.
# Para producción ver .env.production.example.
# ============================================================

# -- Servidor ------------------------------------------------
PORT=3001

# Obligatorio para la base local: relajar el certificado (más abajo) solo se
# acepta con NODE_ENV en development o test.
NODE_ENV=development

# URL pública del backend (enlaces de recuperación de contraseña y fotos)
APP_URL=http://localhost:3001

# Origen de la web permitido por CORS
FRONTEND_URL=http://localhost:3000

# -- Sesión --------------------------------------------------
# COMPLETAR: 32 caracteres o más. Con menos, o vacío, el backend no arranca.
# Genera uno propio, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# -- Base de datos: SQL Server local -------------------------
# La base y la cuenta las crea database/scripts_sql/esquemas/00_crear_base_y_usuario.sql
# (ver backend/README.md, "Inicio rápido").
DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=MiValecito_Dev
DB_USER=mivalecito_app

# COMPLETAR: la contraseña que elegiste al ejecutar 00_crear_base_y_usuario.sql.
# Vacía, el backend no arranca.
DB_PASSWORD=

# SQL Server local usa un certificado autofirmado. Confiar en él solo se
# acepta hacia localhost, con NODE_ENV=development o test y fuera de App Service.
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# Solo puede existir UNA forma de conexión. Con las variables DB_* presentes no
# definas AZURE_SQL_CONNECTION_STRING ni ninguna AZURE_SQL_*: el backend
# rechaza la mezcla al arrancar.

# -- Fotos (opcional) ----------------------------------------
# Sin estas variables las fotos se guardan en la carpeta local datos/uploads/.
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER=

# -- Correo (requerimiento 003) -------------------------------
# En local el transporte es `outbox`: cada correo se escribe como un archivo JSON en
# MAIL_OUTBOX_DIR (por defecto backend/.mail-outbox/, ignorada por Git) y NUNCA sale a la
# red. El archivo trae el enlace completo: ábrelo para probar la activación y la recuperación.
MAIL_TRANSPORT=outbox
# MAIL_OUTBOX_DIR=

# Los enlaces de los correos (/activar, /reset-password) se arman con FRONTEND_URL (arriba),
# nunca con APP_URL ni con el Host de la petición.

# Limpieza diaria de cuentas pendientes vencidas: dry-run (por defecto, solo cuenta),
# apply (elimina o deshabilita) u off.
# PENDING_ACCOUNT_PURGE=dry-run
# PENDING_PURGE_MAX_PER_RUN=50
