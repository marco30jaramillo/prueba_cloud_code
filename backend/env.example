# Configuración del servidor
PORT=3000

# JWT Secret - Cambia esto en producción con un valor seguro
# Usa: openssl rand -base64 32
JWT_SECRET=your-super-secret-key-change-this-in-production

# URL de la aplicación (para enlaces de recuperación de contraseña)
APP_URL=http://localhost:3000

# Opcional: Configuración de email (futuro)
# EMAIL_SERVICE=gmail
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-app-password
# EMAIL_FROM=noreply@example.com

# Opcional: Base de datos
# DATABASE_URL=postgresql://user:password@localhost:5432/auth_db
# DATABASE_POOL_SIZE=10

# Modo de ejecución
NODE_ENV=development
DATA_PROVIDER=csv
# Cambia a sql solo después de cargar roles, permisos y módulos en Azure SQL.

# Azure SQL Database (necesario solo para el importador y la futura migración)
# Nunca subas estos valores al repositorio. Agrega las variables reales a backend/.env.
AZURE_SQL_SERVER=tu-servidor.database.windows.net
AZURE_SQL_DATABASE=tu-base-de-datos
AZURE_SQL_USER=tu-usuario-sql
AZURE_SQL_PASSWORD=tu-password-seguro
# Alternativa a las cuatro variables anteriores:
# AZURE_SQL_CONNECTION_STRING="Server=tcp:tu-servidor.database.windows.net,1433;Initial Catalog=tu-base-de-datos;User ID=tu-usuario-sql;Password=tu-password-seguro;Encrypt=true;TrustServerCertificate=false;Connection Timeout=30;"
