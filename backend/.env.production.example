# ============================================================
# Mi Valecito - backend - variables de PRODUCCIÓN (Azure App Service)
#
# Solo nombres y marcadores. Los valores reales se configuran en el App
# Service (Configuración > Variables de entorno), nunca en un archivo del
# repositorio. Todo lo que está entre < > debe reemplazarse.
# ============================================================

# -- Servidor ------------------------------------------------
PORT=8080
NODE_ENV=production
APP_URL=<url-publica-del-backend>

# -- CORS ----------------------------------------------------
FRONTEND_URL=<url-publica-del-frontend>

# -- Sesión --------------------------------------------------
# 32 caracteres o más. Si falta o es más corto, el backend no arranca.
JWT_SECRET=<secreto-de-32-caracteres-o-mas>

# -- Base de datos: Azure SQL --------------------------------
# Debe existir UNA SOLA forma de conexión. Si coexisten dos, el backend no
# arranca. En producción se usa una de estas dos y ninguna variable DB_*
# (DB_* es la forma de la base local).
#
# Forma A: las cuatro variables AZURE_SQL_* (siempre con cifrado y validando
# el certificado).
AZURE_SQL_SERVER=<servidor>.database.windows.net
AZURE_SQL_DATABASE=<base-de-datos>
AZURE_SQL_USER=<usuario-de-la-aplicacion>
AZURE_SQL_PASSWORD=<contraseña>
#
# Forma B: una cadena de conexión, en lugar de las cuatro anteriores. Debe
# llevar Encrypt=true y TrustServerCertificate=false.
# AZURE_SQL_CONNECTION_STRING=<cadena-de-conexion>

# -- Azure Blob Storage (fotos) ------------------------------
AZURE_STORAGE_CONNECTION_STRING=<cadena-de-conexion-de-la-cuenta-de-almacenamiento>
AZURE_STORAGE_CONTAINER=<contenedor>

# -- Correo (Azure Communication Services Email) -------------
# En producción y QA el único transporte válido es azure; el backend no arranca con otro.
MAIL_TRANSPORT=azure
# SECRETO: solo en la configuración del App Service, nunca en el repositorio.
ACS_EMAIL_CONNECTION_STRING=<cadena-de-conexion-del-recurso-de-communication-services>
# Dirección remitente del dominio verificado en el servicio (hoy el dominio gestionado por
# Azure, DoNotReply@<id>.azurecomm.net). Con dominio propio solo se cambia este valor.
MAIL_FROM=<remitente-del-dominio-verificado>
# FRONTEND_URL (arriba) debe ser la URL exacta y https de la web de ESTE ambiente: arma los
# enlaces de activación y de recuperación de los correos.

# Limpieza diaria de cuentas pendientes vencidas: dry-run (por defecto), apply u off.
# La primera corrida en cada ambiente debe ser dry-run; pasar a apply tras revisar los conteos.
PENDING_ACCOUNT_PURGE=dry-run
