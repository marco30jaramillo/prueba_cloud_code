# ── Servidor ──────────────────────────────────────────────
PORT=8080
NODE_ENV=production
APP_URL=https://<tu-app>.azurewebsites.net

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET=<secreto-minimo-32-caracteres>

# ── Base de datos Azure SQL ───────────────────────────────
DATA_PROVIDER=sql
AZURE_SQL_SERVER=<servidor>.database.windows.net
AZURE_SQL_DATABASE=<base-de-datos>
AZURE_SQL_USER=auth_app_runtime
AZURE_SQL_PASSWORD='<contraseña>'

# ── Azure Blob Storage (imágenes) ─────────────────────────
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<cuenta>;AccountKey=<clave>;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=user-photos

# ── CORS ──────────────────────────────────────────────────
FRONTEND_URL=https://<tu-app>.azurestaticapps.net
